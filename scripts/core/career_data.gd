static func card(id: String) -> Dictionary:
	return CARDS[id]


static func ending_for(totals: Dictionary) -> Dictionary:
	var pick := "steady"
	if int(totals.integrity) < 50:
		pick = "relearn"
	elif int(totals.mistakes) >= 5:
		pick = "close_call"
	elif int(totals.burnouts) >= 2:
		pick = "burnout"
	elif int(totals.integrity) >= 85 and int(totals.s_count) >= 2:
		pick = "ace"
	for e in ENDINGS:
		if e.id == pick:
			return e
	return ENDINGS[-1]


static func grade(ep_perf: int, mistakes: int, lapses: int) -> String:
	if lapses == 0 and mistakes == 0 and ep_perf >= 11:
		return "S"
	if lapses == 0 and mistakes <= 1:
		return "A"
	if lapses <= 1 and mistakes <= 3:
		return "B"
	return "C"
