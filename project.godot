; Engine configuration file.
; 「낙찰! 나라장터 생존기」 — Godot 4.7.2

config_version=5

[application]

config/name="낙찰! 나라장터 생존기"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="공공조달의 업무 현장을 직접 탐색하며 경험하는 3D 교육 시뮬레이션"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.18, 0.24, 0.24, 1)

[gui]

theme/default_font_multichannel_signed_distance_field=true
